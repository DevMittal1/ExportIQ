WTO_API_KEY=
OPENCORPORATES_API_TOKEN=
EXA_SEARCH_API_KEY=
CUSTOMS_DATA_VENDOR_API_KEY=

# Persistence
DATABASE_URL=postgresql://tradepilot:tradepilot@localhost:5432/tradepilot
